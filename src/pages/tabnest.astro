---
import BaseLayout from "../layouts/BaseLayout.astro";

const CHROME_STORE =
  "https://chromewebstore.google.com/detail/tab-nest/necndpocofifkmoekdgbocklmmnldegp";
const GITHUB = "https://github.com/offby1-tech/tabnest";
---

<BaseLayout
  title="Tab Nest — a private tab manager for Chrome | Off By 1"
  description="Tab Nest saves, organizes, and restores your browser tabs, and syncs them to a private folder in your own Google Drive. Free, open source, and built by Off By 1 LLC."
  current="products"
>
  <section class="hero container">
    <div class="hero-grid">
      <div>
        <span class="eyebrow">
          <span class="prompt">~/offby1 $</span> open ./tabnest
        </span>
        <h1 class="display">Tab Nest</h1>
        <p class="tagline">Save the tabs. Close the window.</p>
        <p class="hero-subhead">
          A free Chrome extension that saves, organizes, and restores your tabs
          — synced privately through your own Google Drive.
        </p>
        <p class="hero-sub">
          Tab Nest keeps the pages you're not done with out of your way without
          losing them. Save a whole window as a named session, restore it on any
          machine you're signed in on, and search across everything you've ever
          stashed.
        </p>
        <p class="hero-sub">
          There's no account to create and no server on our end. Your tabs live
          in your browser, and — if you turn on sync — in a private area of your
          own Google Drive that only Tab Nest can reach.
        </p>
        <div class="hero-ctas">
          <a
            class="btn btn-primary"
            href={CHROME_STORE}
            target="_blank"
            rel="noopener noreferrer">Install from the Chrome Web Store ↗</a
          >
          <a
            class="btn btn-secondary"
            href={GITHUB}
            target="_blank"
            rel="noopener noreferrer">View source on GitHub ↗</a
          >
        </div>
      </div>
      <div class="hero-mark floaty">
        <div class="mark-tile">
          <img src="/assets/tabNest_256.png" alt="The Tab Nest app icon" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <span class="section-label">section[1]: what it does</span>
      <h2 class="section-title">What Tab Nest does</h2>
      <p class="section-sub">
        One job, done properly: get tabs out of the way without losing them.
      </p>
      <div class="feature-grid">
        <div class="feature">
          <span class="feature-idx">[0]</span>
          <h3>Save sessions</h3>
          <p>
            Stash a single tab, a tab group, or an entire window as a named
            session you can bring back later — in one click, or one tab at a
            time.
          </p>
        </div>
        <div class="feature">
          <span class="feature-idx">[1]</span>
          <h3>Organize what you saved</h3>
          <p>
            Rename sessions, regroup them, and prune the ones you're done with.
            Saved tabs keep their titles and groupings, so a restored window
            looks like the one you closed.
          </p>
        </div>
        <div class="feature">
          <span class="feature-idx">[2]</span>
          <h3>Search everything</h3>
          <p>
            Search titles and URLs across every session you've saved. Finding
            that one article you closed three weeks ago is a search, not an
            archaeology dig.
          </p>
        </div>
        <div class="feature">
          <span class="feature-idx">[3]</span>
          <h3>Sync across devices</h3>
          <p>
            Optional Google Drive sync makes your saved tabs available on every
            computer where you've installed Tab Nest and signed in. Leave it off
            and everything stays local to that browser.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="privacy">
    <div class="container">
      <span class="section-label">section[2]: privacy</span>
      <h2 class="section-title">How your data is handled</h2>
      <p class="section-sub">
        Tab Nest has no backend. Off By 1 LLC operates no server for it, so your
        saved tabs never reach us — there is nothing on our side to collect,
        log, sell, or breach.
      </p>
      <div class="about-grid">
        <div class="about-copy">
          <p>
            When you enable sync, Tab Nest asks for a single Google
            authorization scope: <code class="scope">drive.appdata</code>. That
            scope grants access to a hidden Application Data folder that Google
            sets aside for Tab Nest inside your Drive — and nothing else.
          </p>
          <p>
            <strong>Tab Nest cannot see, open, or modify any of your other
            Drive files.</strong> The folder it writes to doesn't appear in your
            normal Drive view, the data stays in your own Drive storage, and you
            can delete it or revoke access at any time from your Google account
            settings.
          </p>
          <p>
            There are no analytics, no advertising, no trackers, and no
            third-party SDKs inside the extension. Tab Nest's use of information
            received from Google APIs adheres to the <a
              href="https://developers.google.com/terms/api-services-user-data-policy"
              target="_blank"
              rel="noopener noreferrer">Google API Services User Data Policy</a
            >, including the Limited Use requirements.
          </p>
        </div>
        <div class="scope-card">
          <p class="scope-card-label">Requested Google scope</p>
          <p class="scope-card-scope">
            https://www.googleapis.com/auth/drive.appdata
          </p>
          <ul class="scope-card-list">
            <li>Reads and writes only Tab Nest's own hidden app folder</li>
            <li>No access to your other Drive files</li>
            <li>Requested only when you turn on sync</li>
            <li>Revocable at any time</li>
          </ul>
          <div class="contact-row" style="margin-top: 24px;">
            <a class="btn btn-secondary" href="/tabnest-privacy"
              >Read the full privacy policy</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="install">
    <div class="container">
      <span class="section-label">section[3]: install</span>
      <h2 class="section-title">Get Tab Nest</h2>
      <p class="section-sub">
        Free, open source, and published by Off By 1 LLC. Install it from the
        Chrome Web Store, or read the code first — both links go to the same
        extension.
      </p>
      <div class="contact-row">
        <a
          class="btn btn-primary"
          href={CHROME_STORE}
          target="_blank"
          rel="noopener noreferrer">Chrome Web Store ↗</a
        >
        <a
          class="btn btn-secondary"
          href={GITHUB}
          target="_blank"
          rel="noopener noreferrer">GitHub ↗</a
        >
        <a class="btn btn-secondary" href="/tabnest-privacy">Privacy policy</a>
      </div>
    </div>
  </section>

  <section class="section" id="support">
    <div class="container">
      <span class="section-label">section[4]: support</span>
      <h2 class="section-title">Support</h2>
      <p class="section-sub">
        Bug reports, feature requests, or a question about your data — a real
        human reads all of it.
      </p>
      <div class="contact-row">
        <a class="btn btn-primary" href="mailto:contact@offby1.tech"
          >contact@offby1.tech</a
        >
        <a
          class="btn btn-secondary"
          href={`${GITHUB}/issues`}
          target="_blank"
          rel="noopener noreferrer">Open an issue ↗</a
        >
      </div>
      <p class="section-sub" style="margin-top: 32px;">
        Tab Nest is published by Off By 1 LLC, a Washington limited liability
        company. <a href="/">More about Off By 1 →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 56px;
    margin-top: 44px;
  }
  .feature-idx {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-3);
    display: block;
    margin-bottom: 8px;
  }
  .feature h3 {
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }
  .feature p {
    color: var(--text-2);
    max-width: 46ch;
    text-wrap: pretty;
  }

  code.scope {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--bg-card);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .scope-card {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    padding: 26px 28px;
    background: var(--bg-card);
  }
  .scope-card-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--link);
    margin-bottom: 10px;
  }
  .scope-card-scope {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text);
    word-break: break-all;
    margin-bottom: 18px;
  }
  .scope-card-list {
    margin: 0;
    padding-left: 20px;
    color: var(--text-2);
    font-size: 15px;
  }
  .scope-card-list li + li {
    margin-top: 8px;
  }

  .about-copy a,
  .section-sub a {
    color: var(--link);
  }
  .about-copy a:hover,
  .section-sub a:hover {
    color: var(--link-hover);
  }

  @media (max-width: 820px) {
    .feature-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
